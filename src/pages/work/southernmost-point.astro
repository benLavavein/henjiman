---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';

const sections = [
	{ number: '01', title: 'The project', content: 'Southernmost Point Guest House needed a complete redesign that better reflected the property and made its rooms, amenities, history, extended-stay options, bar, and guest information easier to explore on any screen.' },
	{ number: '02', title: 'The rebuild', content: 'I rebuilt the site with Astro and organized repeated interface patterns into reusable layouts and components. Room information and other repeated content were moved into structured data, making the site easier to update without duplicating markup across pages.' },
	{ number: '03', title: 'Guest inquiries', content: 'I implemented inquiry forms for events and extended stays with validation, bot protection, and dependable email delivery. I also handled responsive behavior, navigation, search-engine essentials, analytics, and the smaller production details needed for a public hospitality website.' },
];

const technologies = ['Astro', 'TypeScript', 'Tailwind CSS'];

const galleryImages = [
	{ src: '/images/southernmost-point-bar.png', alt: 'Southernmost Point Guest House bar page with colorful cocktails and a description of live music', caption: 'The bar' },
	{ src: '/images/southernmost-point-rooms.png', alt: 'Southernmost Point Guest House room listings with photos and descriptions', caption: 'Rooms and amenities' },
];
---

<CaseStudyPage
	pageTitle="Southernmost Point Guest House — Ben Hayden"
	description="A case study of Ben Hayden’s complete website redesign and email workflow work for Southernmost Point Guest House."

	heading="Southernmost Point Guest House"
	subtitle="Historic guest house"
	introduction="I redesigned and rebuilt the Southernmost Point Guest House website, creating a responsive Astro site that presents the property clearly and makes guest inquiries dependable."
	role="Web Developer"
	projectLinkLabel="See the site live"
	companyUrl="https://southernmostpoint.com/"
	shareImage="/images/southernmost-point-home.png"
	project="southernmost-point"
	skillsIntroduction="This project combined a complete responsive redesign with component architecture, content modeling, server-side form handling, transactional email, accessibility work, analytics, and deployment."
	{technologies}
	{sections}
>
	<img
		slot="media"
		class="block h-auto w-full"
		src="/images/southernmost-point-home.png"
		alt="Southernmost Point Guest House homepage with the historic property, garden, and reservation navigation"
	/>
	<ProjectGallery slot="gallery" heading="Southernmost Point" images={galleryImages} siteUrl="https://southernmostpoint.com/" />
</CaseStudyPage>
