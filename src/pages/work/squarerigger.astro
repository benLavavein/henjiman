---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';

const sections = [
	{ number: '01', title: 'The product', content: 'Squarerigger brings equipment records, preventive maintenance, work requests and orders, labor, parts, inventory, purchasing, fuel, inspections, and reporting into one fleet operations platform.' },
	{ number: '02', title: 'My role', content: 'As lead developer, I worked across the product and the stack. I helped shape features with the team, made architectural decisions, built interfaces and APIs, reviewed work, and kept projects moving from an initial idea to production.' },
	{ number: '03', title: 'Owning delivery', content: 'My role did not stop when the code was merged. I helped plan sprints, break larger projects into practical releases, deploy updates to live customers, and ship hotfixes when urgent problems came up.' },
	{ number: '04', title: 'Working with customers', content: 'I regularly joined customer calls to see problems firsthand, walk through unexpected behavior, and understand how the software was being used in practice. That feedback helped us diagnose issues and decide what to improve next.' },
	{ number: '05', title: 'Technical leadership', content: 'I worked to make the codebase easier for the team to build on by creating reusable patterns, reviewing edge cases, improving shared systems, and balancing short-term customer needs with long-term maintainability.' },
];

const technologies = ['React', 'TypeScript', 'PostgreSQL', 'AWS'];

const galleryImages = [
	{ src: '/images/squarerigger-equipment.png', alt: 'Squarerigger equipment record with vehicle details, odometer, and assigned location', caption: 'Equipment records' },
	{ src: '/images/squarerigger-purchase-order.png', alt: 'Squarerigger purchase order form with vendor, shipping, and part details', caption: 'Purchasing' },
	{ src: '/images/squarerigger-tire-inspection.png', alt: 'Squarerigger tire inspection with axle diagram, tread measurements, pressure, and service plan', caption: 'Tire inspections' },
	{ src: '/images/squarerigger-equipment-report.png', alt: 'Squarerigger equipment by location report with summary metrics and chart', caption: 'Reporting' },
	{ src: '/images/squarerigger-part-inventory.png', alt: 'Squarerigger part record showing stock, purchase history, and related work orders', caption: 'Parts inventory' },
];
---

<CaseStudyPage
	pageTitle="Squarerigger Fleet Maintenance — Ben Hayden"
	description="A case study of Ben Hayden’s work as lead developer on Squarerigger’s fleet maintenance web application."

	heading="Squarerigger"
	subtitle="Fleet maintenance"
	introduction="I served as a lead developer on Squarerigger, a full-stack web application used by fleets across the nation. It brings equipment management, work orders, time tracking, parts inventory, purchasing, inspections, fuel, and reporting into one place."
	role="Lead Developer"
	teamName="LavaVein"
	teamUrl="https://lavavein.com"
	projectLinkLabel="Learn more"
	companyUrl="https://squarerigger.com"
	shareImage="/images/squarerigger-work-orders.png"
	creature="squirrel"
	skillsIntroduction="The application spans responsive product interfaces, typed APIs, relational data modeling, background jobs, analytics, authentication, permissions, testing, and cloud deployment."
	{technologies}
	{sections}
>
	<img
		slot="media"
		class="block h-auto w-full"
		src="/images/squarerigger-work-orders.png"
		alt="Squarerigger work orders table with a selected order, maintenance notes, and services in a detail panel"
	/>
	<ProjectGallery slot="gallery" heading="Squarerigger" images={galleryImages} />
</CaseStudyPage>
