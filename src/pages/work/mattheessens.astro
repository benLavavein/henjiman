---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';

const sections = [
	{ number: '01', title: 'The project', content: 'Mattheessen’s is a family-owned bakery with locations in Key West and Nashville. I refreshed the existing website to better present its products, locations, story, and online ordering experience across desktop and mobile.' },
	{ number: '02', title: 'Checkout and payments', content: 'A major part of the work was making the online-ordering flow dependable. I repaired and updated the PayPal integration, added server-side order verification, and improved the checkout experience so order details and totals stayed consistent through payment.' },
	{ number: '03', title: 'Order communication', content: 'I rebuilt the order-confirmation flow to send clear, branded emails to both the customer and the business. The emails include the information each recipient needs while safely handling customer and order data.' },
];

const technologies = ['HTML', 'CSS', 'JavaScript'];

const galleryImages = [
	{ src: '/images/mattheessens-build-a-box.png', alt: 'Mattheessen’s custom cookie box builder showing selected cookies and available flavors', caption: 'Build-your-own cookie box' },
	{ src: '/images/mattheessens-cart.png', alt: 'Mattheessen’s shopping cart with a cookie box, fudge bundle, order total, and checkout button', caption: 'Cart and checkout' },
];
---

<CaseStudyPage
	pageTitle="Mattheessen’s — Ben Hayden"
	description="A case study of Ben Hayden’s website redesign, PayPal integration, and order-confirmation work for Mattheessen’s."

	heading="Mattheessen’s"
	subtitle="Family-owned sweets shoppe"
	introduction="I refreshed Mattheessen’s website and ordering experience, improving the responsive presentation while fixing the PayPal checkout and email-confirmation systems behind it."
	role="Web Developer"
	projectLinkLabel="See the site live"
	companyUrl="https://www.mattskeywest.com/"
	shareImage="/images/mattheessens-products.png"
	project="mattheessens"
	skillsIntroduction="This project combined responsive frontend work with payment integration, serverless order verification, transactional email delivery, and production deployment."
	{technologies}
	{sections}
>
	<img
		slot="media"
		class="block h-auto w-full"
		src="/images/mattheessens-products.png"
		alt="Mattheessen’s product showcase featuring cookies, fudge, macaroons, pie, and ice cream"
	/>
	<ProjectGallery slot="gallery" heading="Mattheessen’s" images={galleryImages} siteUrl="https://www.mattskeywest.com/" />
</CaseStudyPage>
