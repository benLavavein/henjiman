---
import '../styles/global.css';
import WoodlandChrome from '../components/WoodlandChrome.astro';
import WoodlandInit from '../components/WoodlandInit.astro';
import ShareMeta from '../components/ShareMeta.astro';
import FaviconLinks from '../components/FaviconLinks.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <WoodlandInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Get in touch with Ben Hayden about your next web project." />
    <ShareMeta title="Contact — Ben Hayden" description="Have a web project in mind? Get in touch with Ben Hayden." />
    <FaviconLinks />
    <title>Contact — Ben Hayden</title>
  </head>
  <body class="woodland-page">
    <WoodlandChrome />
    <div class="page-shell">
      <main>
        <section class="grid min-h-[72vh] content-center gap-14 py-20 sm:py-28 lg:grid-cols-2 lg:gap-24">
          <div class="animate-in delay-1">
            <h1 class="text-[clamp(3.5rem,7vw,7rem)] font-semibold leading-[0.9] tracking-[-0.065em]">Let’s talk.</h1>
            <p class="mt-8 max-w-md text-lg leading-8 text-muted">Have something in mind? I’d love to hear about it.</p>
            <address class="mt-10 space-y-4 not-italic text-lg">
              <p class="font-semibold">Ben Hayden</p>
              <p><a class="nav-link underline underline-offset-4" href="mailto:bendanielhayden@gmail.com">bendanielhayden@gmail.com</a></p>
              <div class="flex gap-6">
                <a class="nav-link underline underline-offset-4" href="https://github.com/benLavavein" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a class="nav-link underline underline-offset-4" href="https://www.linkedin.com/in/henjiman/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              </div>
            </address>
          </div>
          <form class="contact-form space-y-6 animate-in delay-2" action="/api/contact" method="post" aria-label="Contact Ben" aria-describedby="form-notice">
            <div><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" placeholder="What do you go by?" maxlength="100" required /></div>
            <div><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email" placeholder="youremail@domain.com" maxlength="254" required /></div>
            <div><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="5" placeholder="What do you want to build?" maxlength="5000" required></textarea></div>
            <div class="contact-trap" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
            <div class="turnstile-widget"></div>
            <p id="form-notice" class="text-sm leading-6 text-muted" role="status" aria-live="polite"></p>
            <button class="button-primary" type="submit" disabled>Send message</button>
          </form>
        </section>
      </main>
      <footer class="border-t border-line py-9 text-sm text-muted">© {new Date().getFullYear()} Ben Hayden</footer>
    </div>
  </body>
</html>

<script>
  type Turnstile = {
    render: (element: HTMLElement, options: {
      sitekey: string;
      action: string;
      theme: string;
      callback: () => void;
      'expired-callback': () => void;
      'error-callback': () => void;
    }) => string;
    reset: (widgetId: string) => void;
  };

  let turnstileLoad: Promise<Turnstile> | undefined;

  function loadTurnstile() {
    const browser = window as Window & { turnstile?: Turnstile };
    if (browser.turnstile) return Promise.resolve(browser.turnstile);
    turnstileLoad ??= new Promise<Turnstile>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.onload = () => browser.turnstile ? resolve(browser.turnstile) : reject(new Error('Turnstile unavailable'));
      script.onerror = () => reject(new Error('Turnstile unavailable'));
      document.head.append(script);
    }).catch((error) => {
      turnstileLoad = undefined;
      throw error;
    });
    return turnstileLoad;
  }

  const initializedForms = new WeakSet<HTMLFormElement>();

  async function setupContactForm() {
    const form = document.querySelector<HTMLFormElement>('.contact-form');
    const widget = form?.querySelector<HTMLElement>('.turnstile-widget');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const notice = form?.querySelector<HTMLElement>('#form-notice');
    if (!form || !widget || !button || !notice || initializedForms.has(form)) return;
    initializedForms.add(form);

    let turnstile: Turnstile;
    let widgetId: string;
    let sent = false;
    try {
      const configResponse = await fetch('/api/contact-config', { cache: 'no-store' });
      if (!configResponse.ok) throw new Error('Contact form not configured');
      const config = await configResponse.json() as { sitekey?: string };
      if (!config.sitekey) throw new Error('Contact form not configured');
      turnstile = await loadTurnstile();
      if (!widget.isConnected) return;
      widgetId = turnstile.render(widget, {
        sitekey: config.sitekey,
        action: 'contact',
        theme: 'light',
        callback: () => {
          button.disabled = false;
          if (!sent) notice.textContent = '';
        },
        'expired-callback': () => {
          button.disabled = true;
          notice.textContent = 'The security check expired. Please complete it again.';
        },
        'error-callback': () => {
          button.disabled = true;
          notice.textContent = 'The security check could not load. Please refresh or email me directly.';
        },
      });
    } catch {
      notice.textContent = 'The form is unavailable right now. Please email me directly.';
      return;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled || !form.reportValidity()) return;
      button.disabled = true;
      button.textContent = 'Sending…';
      notice.textContent = 'Sending your message…';

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const result = await response.json() as { message?: string };
        notice.textContent = result.message || 'I could not send your message. Please email me directly.';
        if (response.ok) {
          sent = true;
          form.reset();
        }
      } catch {
        notice.textContent = 'I could not send your message. Please email me directly.';
      } finally {
        button.textContent = 'Send message';
        turnstile.reset(widgetId);
      }
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
  setupContactForm();
</script>

<style>
  .contact-form label { display: block; margin-bottom: 10px; font-weight: 600; }
  .contact-form input, .contact-form textarea { display: block; width: 100%; border: 1px solid #71816560; border-radius: 12px; padding: 14px 16px; background: #f3f1eb; color: #243e30; font: inherit; }
  .contact-form textarea { resize: vertical; min-height: 150px; }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: #626b5d; opacity: 1; }
  .contact-form input:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid #526744; outline-offset: 3px; }
  .contact-form button:disabled { opacity: .6; cursor: not-allowed; }
  .contact-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
