---
import ProjectCard from '../components/ProjectCard.astro';
import WoodlandHero from '../components/WoodlandHero.astro';
import WoodlandChrome from '../components/WoodlandChrome.astro';
import WoodlandInit from '../components/WoodlandInit.astro';
import ShareMeta from '../components/ShareMeta.astro';
import FaviconLinks from '../components/FaviconLinks.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<WoodlandInit />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Ben Hayden is a software developer building useful, dependable products for the web." />
		<ShareMeta title="Ben Hayden — Software Developer" description="I bring ideas to life on the web. Explore my projects and get in touch." />
		<FaviconLinks />
		<meta name="generator" content={Astro.generator} />
		<title>Ben Hayden — Software Developer</title>
	</head>
	<body class="woodland-page">
		<WoodlandChrome />
		<div class="page-shell">
			<main id="top">
				<WoodlandHero />
				<section class="pt-10 pb-20 sm:pt-14 sm:pb-28" aria-labelledby="selected-work">
					<div class="mb-12 sm:mb-16">
						<h2 id="selected-work" class="mt-5 text-4xl font-semibold leading-tight tracking-[-0.045em] sm:text-5xl">Here are some projects I've been a part of:</h2>
					</div>
					<div class="space-y-6">
						<ProjectCard
							title="Squarerigger"
							subtitle="Fleet maintenance"
							role="Lead Developer"
							description="A fleet operations platform for managing equipment, maintenance, work orders, parts, inventory, purchasing, inspections, fuel, and reporting."
							href="/work/squarerigger/"
							imageSrc="/images/squarerigger-work-orders.png"
							imageAlt="Squarerigger work orders table with a selected order, maintenance notes, and services in a detail panel"
						/>
						<ProjectCard
							title="TechXcel"
							subtitle="IT apprenticeships"
							role="Web Developer"
							description="A website for a government-funded program helping Registered Apprenticeship sponsors grow IT training opportunities across the country. The site is not yet launched."
							href="/work/techxcel/"
							imageSrc="/images/techxcel-home.png"
							imageAlt="TechXcel homepage with program overview, sponsor application button, and apprenticeship video"
							mediaPosition="right"
						/>
						<ProjectCard
							title="Scope"
							subtitle="School layout budget estimation"
							role="Sole Developer"
							description="A school budgeting system built for Meteor Education that turns enrollment, facility, and asset requirements into detailed, adjustable project estimates."
							href="/work/meteor-scope/"
							imageSrc="/images/scope-dashboard.png"
							imageAlt="Scope dashboard showing estimates, assets, facility types, school types, and quick actions"
							mediaPosition="left"
						/>
						<ProjectCard
							title="Mattheessen’s"
							subtitle="Family-owned sweets shoppe"
							role="Web Developer"
							description="A responsive website and online-ordering refresh for a family-owned bakery, including reliable PayPal checkout and order-confirmation emails."
							href="/work/mattheessens/"
							imageSrc="/images/mattheessens-products.png"
							imageAlt="Mattheessen’s website showing cookies, fudge, macaroons, pie, and ice cream"
							mediaPosition="right"
						/>
						<ProjectCard
							title="Southernmost Point Guest House"
							subtitle="Historic guest house"
							role="Web Developer"
							description="A complete website redesign for a historic Key West guest house, rebuilt as a responsive Astro site with reusable content and dependable inquiry emails."
							href="/work/southernmost-point/"
							imageSrc="/images/southernmost-point-home.png"
							imageAlt="Southernmost Point Guest House homepage showing the historic guest house and garden"
							mediaPosition="left"
						/>
					</div>
				</section>
			</main>
			<footer class="flex flex-col gap-6 border-t border-line py-9 text-sm text-muted sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Ben Hayden</p><nav aria-label="Primary navigation" class="flex gap-6"><a class="nav-link" href="/" aria-current="page">Home</a><a class="nav-link" href="/about/">About</a><a class="nav-link" href="/contact/">Contact</a></nav><div class="flex gap-6"><a class="nav-link" href="https://github.com/benLavavein" target="_blank" rel="noreferrer">GitHub</a><a class="nav-link" href="https://www.linkedin.com/in/henjiman/" target="_blank" rel="noreferrer">LinkedIn</a></div></footer>
		</div>
	</body>
</html>
