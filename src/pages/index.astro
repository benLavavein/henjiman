---
import ProjectCard from '../components/ProjectCard.astro';
import WoodlandHero from '../components/WoodlandHero.astro';
import WoodlandChrome from '../components/WoodlandChrome.astro';
import WoodlandInit from '../components/WoodlandInit.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<WoodlandInit />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Ben Hayden is a software developer building useful, dependable products for the web." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Ben Hayden — Software Developer</title>
	</head>
	<body class="woodland-page">
		<WoodlandChrome />
		<div class="page-shell">
			<main id="top">
				<WoodlandHero />
				<section class="border-t border-line py-20 sm:py-28" aria-labelledby="selected-work">
					<div class="section-grid mb-12 sm:mb-16">
						<div><h2 id="selected-work" class="section-heading">A closer look at what I’ve built.</h2></div>
						<p class="max-w-2xl self-end text-lg leading-8 text-muted">A few of the products I’ve helped take from an idea to something people use.</p>
					</div>
					<div class="space-y-8">
						<ProjectCard
							title="Squarerigger"
							subtitle="Fleet maintenance"
							role="Lead Developer"
							description="A fleet operations platform for managing equipment, maintenance, work orders, parts, inventory, purchasing, inspections, fuel, and reporting."
							href="/work/squarerigger/"
							tags={['React', 'TypeScript', 'PostgreSQL', 'AWS']}
							imageSrc="/images/squarerigger-work-order.png"
							imageAlt="Squarerigger work-order workspace showing services, parts, invoice totals, accounting settings, and fleet navigation"
						/>
						<ProjectCard
							title="Scope"
							subtitle="School layout budget estimation"
							role="Sole Developer"
							description="A school budgeting system built for Meteor Education that turns enrollment, facility, and asset requirements into detailed, adjustable project estimates."
							href="/work/meteor-scope/"
							tags={['Laravel', 'PHP', 'Livewire', 'Tailwind CSS']}
							imageSrc="/images/scope-estimate-editor.png"
							imageAlt="Scope estimate editor showing project information, facility categories, team assignments, and a live budget summary"
							mediaPosition="right"
						/>
						<ProjectCard
							title="Mattheessen’s"
							subtitle="Family-owned sweet treats"
							role="Web Developer"
							description="A responsive website and online-ordering refresh for a family-owned Key West bakery, including reliable PayPal checkout and order-confirmation emails."
							href="/work/mattheessens/"
							tags={['HTML', 'CSS', 'JavaScript']}
							imageSrc="/images/mattheessens-homepage.png"
							imageAlt="Mattheessen’s bakery homepage with its branding, navigation, and bakery oven hero image"
						/>
						<ProjectCard
							title="Southernmost Point Guest House"
							subtitle="Historic guest house"
							role="Web Developer"
							description="A complete website redesign for a historic Key West guest house, rebuilt as a responsive Astro site with reusable content and dependable inquiry emails."
							href="/work/southernmost-point/"
							tags={['Astro', 'TypeScript', 'Tailwind CSS']}
							imageSrc="/images/southernmost-point-homepage.png"
							imageAlt="Southernmost Point Guest House homepage showing the historic guest house and garden"
							mediaPosition="right"
						/>
					</div>
				</section>
			</main>
			<footer class="flex flex-col gap-6 border-t border-line py-9 text-sm text-muted sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Ben Hayden</p><nav aria-label="Primary navigation" class="flex gap-6"><a class="nav-link" href="/" aria-current="page">Home</a><a class="nav-link" href="/about/">About</a><a class="nav-link" href="/contact/">Contact</a></nav><div class="flex gap-6"><a class="nav-link" href="https://github.com/benLavavein" target="_blank" rel="noreferrer">GitHub</a><a class="nav-link" href="https://www.linkedin.com/in/henjiman/" target="_blank" rel="noreferrer">LinkedIn</a></div></footer>
		</div>
	</body>
</html>
