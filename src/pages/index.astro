---
import '../styles/global.css';

const projects = [
	{ title: 'Project Alpha', description: 'A thoughtful digital product built to make a complicated workflow feel simple.', stack: ['TypeScript', 'Astro', 'PostgreSQL'] },
	{ title: 'Project Beta', description: 'An open-source tool focused on speed, clarity, and a great developer experience.', stack: ['Node.js', 'Tailwind', 'Cloudflare'] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Ben Hayden is a software developer building useful, dependable products for the web." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Ben Hayden — Software Developer</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="flex items-center justify-between py-7 sm:py-9">
				<a class="group flex items-center gap-3" href="#top" aria-label="Ben Hayden, home"><span class="grid size-9 place-items-center rounded-full bg-ink text-sm font-bold text-paper transition-transform group-hover:-rotate-6">BH</span><span class="font-semibold tracking-tight">Ben Hayden</span></a>
				<nav aria-label="Primary navigation"><ul class="flex items-center gap-5 text-sm font-medium text-muted sm:gap-7"><li><a class="nav-link" href="#work">Work</a></li><li><a class="nav-link" href="#about">About</a></li><li><a class="nav-link" href="mailto:ben@lavavein.com">Contact</a></li></ul></nav>
			</header>
			<main id="top">
				<section class="grid min-h-[70vh] content-center py-20 sm:py-28"><div class="max-w-4xl">
					<p class="eyebrow animate-in">Software developer · Builder · Problem solver</p>
					<h1 class="mt-7 max-w-4xl text-balance text-[clamp(3.4rem,10vw,8.5rem)] font-semibold leading-[0.88] tracking-[-0.07em] animate-in delay-1">I build useful things for the web.</h1>
					<p class="mt-9 max-w-2xl text-pretty text-lg leading-8 text-muted animate-in delay-2 sm:text-xl">I’m Ben, a software developer who turns complex ideas into clear, dependable products. I care about thoughtful details, resilient systems, and work that earns its place.</p>
					<div class="mt-10 flex flex-wrap items-center gap-4 animate-in delay-3"><a class="button-primary" href="#work">See my work <span aria-hidden="true">↘</span></a><a class="button-secondary" href="mailto:ben@lavavein.com">Let’s talk</a></div>
				</div></section>
				<section id="work" class="section-grid border-t border-line py-20 sm:py-28">
					<div><p class="eyebrow">Selected work</p><h2 class="section-heading">A few things I’ve made.</h2></div>
					<div class="grid gap-px overflow-hidden rounded-3xl bg-line sm:grid-cols-2">{projects.map((project, index) => (
						<article class="group flex min-h-80 flex-col bg-card p-7 transition-colors hover:bg-white sm:p-9"><div class="flex items-start justify-between"><span class="font-mono text-xs text-muted">0{index + 1}</span><span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></div><div class="mt-auto"><h3 class="text-2xl font-semibold tracking-tight">{project.title}</h3><p class="mt-3 max-w-sm leading-7 text-muted">{project.description}</p><ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies used">{project.stack.map((item) => <li class="tag">{item}</li>)}</ul></div></article>
					))}</div>
				</section>
				<section id="about" class="section-grid border-t border-line py-20 sm:py-28"><div><p class="eyebrow">About me</p><h2 class="section-heading">Curious by default.</h2></div><div class="max-w-2xl space-y-6 text-lg leading-8 text-muted"><p>I enjoy working across the stack, from the first sketch of an interface to the systems that keep it running. The best work, to me, feels obvious in hindsight.</p><p>When I’m not writing code, you’ll usually find me learning something new, making things, or getting away from a screen for a while.</p></div></section>
			</main>
			<footer class="flex flex-col gap-6 border-t border-line py-9 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Ben Hayden</p><div class="flex gap-6"><a class="nav-link" href="https://github.com/benLavavein" rel="noreferrer">GitHub</a><a class="nav-link" href="https://www.linkedin.com/in/henjiman/" rel="noreferrer">LinkedIn</a></div></footer>
		</div>
	</body>
</html>
