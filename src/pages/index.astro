---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Ben Hayden is a software developer building useful, dependable products for the web." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Ben Hayden — Software Developer</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="flex items-center justify-end py-7 sm:py-9">
				<nav aria-label="Primary navigation"><ul class="flex items-center gap-5 text-sm font-medium text-muted sm:gap-7"><li><a class="nav-link" href="/about/">About</a></li><li><a class="nav-link" href="mailto:ben@lavavein.com">Contact</a></li></ul></nav>
			</header>
			<main id="top">
				<section class="grid min-h-[76vh] content-center py-20 sm:py-28"><div class="max-w-5xl">
					<p class="eyebrow animate-in">Software developer · Builder · Problem solver</p>
					<h1 class="mt-7 max-w-5xl text-balance text-[clamp(3.4rem,9vw,8rem)] font-semibold leading-[0.9] tracking-[-0.07em] animate-in delay-1">I am henjiman<br />I build incredible things for the web.</h1>
					<p class="mt-9 max-w-3xl text-pretty text-lg leading-8 text-muted animate-in delay-2 sm:text-xl">I’m Ben, a developer who can push your ideas to become finished products. My passion is staying up to date with the latest in web development and creating resilient, dependable software that blows you away.</p>
					<div class="mt-10 animate-in delay-3"><a class="button-primary" href="mailto:ben@lavavein.com">Let’s talk <span aria-hidden="true">↗</span></a></div>
				</div></section>
			</main>
			<footer class="flex flex-col gap-6 border-t border-line py-9 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Ben Hayden</p><div class="flex gap-6"><a class="nav-link" href="https://github.com/benLavavein" rel="noreferrer">GitHub</a><a class="nav-link" href="https://www.linkedin.com/in/henjiman/" rel="noreferrer">LinkedIn</a></div></footer>
		</div>
	</body>
</html>
