---
import '../styles/global.css';

interface CaseStudySection {
	number: string;
	title: string;
	content: string;
}

interface Props {
	pageTitle: string;
	description: string;
	eyebrow: string;
	heading: string;
	introduction: string;
	role: string;
	product: string;
	company: string;
	companyUrl?: string;
	imageTitle: string;
	imageDescription: string;
	skillsIntroduction: string;
	technologies: string[];
	sections: CaseStudySection[];
}

const {
	pageTitle,
	description,
	eyebrow,
	heading,
	introduction,
	role,
	product,
	company,
	companyUrl,
	imageTitle,
	imageDescription,
	skillsIntroduction,
	technologies,
	sections,
} = Astro.props;

const hasMedia = Astro.slots.has('media');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="flex items-center justify-between py-7 sm:py-9">
				<a class="nav-link text-sm font-semibold" href="/">Ben Hayden</a>
				<nav aria-label="Primary navigation"><ul class="flex items-center gap-5 text-sm font-medium text-muted sm:gap-7"><li><a class="nav-link" href="/">Home</a></li><li><a class="nav-link" href="/about/">About</a></li><li><a class="nav-link" href="mailto:ben@lavavein.com">Contact</a></li></ul></nav>
			</header>

			<main>
				<section class="border-b border-line py-20 sm:py-28">
					<p class="eyebrow animate-in">{eyebrow}</p>
					<h1 class="mt-7 max-w-5xl text-balance text-[clamp(3.5rem,8vw,7.5rem)] font-semibold leading-[0.92] tracking-[-0.065em] animate-in delay-1">{heading}</h1>
					<p class="mt-9 max-w-3xl text-pretty text-lg leading-8 text-muted animate-in delay-2 sm:text-xl">{introduction}</p>
					<div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3 animate-in delay-3">
						<div class="bg-paper p-6"><p class="eyebrow">Role</p><p class="mt-3 font-semibold">{role}</p></div>
						<div class="bg-paper p-6"><p class="eyebrow">Product</p><p class="mt-3 font-semibold">{product}</p></div>
						<div class="bg-paper p-6"><p class="eyebrow">Company</p>{companyUrl ? <a class="nav-link mt-3 inline-block font-semibold underline decoration-line underline-offset-4" href={companyUrl} target="_blank" rel="noreferrer">{company} ↗</a> : <p class="mt-3 font-semibold">{company}</p>}</div>
					</div>
				</section>

				<section class="py-16 sm:py-24" aria-labelledby={hasMedia ? undefined : 'project-preview'}>
					{hasMedia ? <div class="overflow-hidden rounded-[2rem] border border-line bg-[#181a19] p-3 sm:p-5"><div class="overflow-hidden rounded-xl"><slot name="media" /></div></div> : <div class="relative min-h-[28rem] overflow-hidden rounded-[2rem] bg-[#181a19] p-6 sm:min-h-[40rem] sm:p-10">
						<div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(166,79,54,0.22),transparent_30%),radial-gradient(circle_at_82%_82%,rgba(243,241,235,0.12),transparent_38%)]"></div>
						<div class="relative flex min-h-[25rem] items-center justify-center rounded-2xl border border-white/15 bg-white/5 p-8 sm:min-h-[35rem]">
							<slot name="media">
								<div class="text-center text-paper"><p class="font-mono text-xs uppercase tracking-[0.18em] text-paper/55">Project imagery</p><h2 id="project-preview" class="mt-4 text-3xl font-semibold tracking-[-0.04em]">{imageTitle}</h2><p class="mx-auto mt-4 max-w-md leading-7 text-paper/60">{imageDescription}</p></div>
							</slot>
						</div>
					</div>}
				</section>

				<section class="border-t border-line py-16 sm:py-24">
					<div class="section-grid">
						<div><p class="eyebrow">Skills and tools</p><h2 class="section-heading">Full-stack product development.</h2></div>
						<div><p class="max-w-2xl text-lg leading-8 text-muted">{skillsIntroduction}</p><ul class="mt-8 flex flex-wrap gap-2" aria-label="Technologies used">{technologies.map((technology) => <li class="tag">{technology}</li>)}</ul></div>
					</div>
				</section>

				<section class="border-t border-line py-16 sm:py-24">
					<div class="section-grid">
						<div><p class="eyebrow">Case study</p><h2 class="section-heading">The work behind the product.</h2></div>
						<div class="divide-y divide-line border-y border-line">
							{sections.map((section) => <section class="grid gap-4 py-8 sm:grid-cols-[4rem_1fr] sm:py-10"><span class="font-mono text-xs text-muted">{section.number}</span><div><h3 class="text-2xl font-semibold tracking-[-0.035em]">{section.title}</h3><p class="mt-3 max-w-2xl leading-7 text-muted">{section.content}</p></div></section>)}
						</div>
					</div>
				</section>
			</main>

			<footer class="flex flex-col gap-6 border-t border-line py-9 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Ben Hayden</p><div class="flex gap-6"><a class="nav-link" href="https://github.com/benLavavein" target="_blank" rel="noreferrer">GitHub</a><a class="nav-link" href="https://www.linkedin.com/in/henjiman/" target="_blank" rel="noreferrer">LinkedIn</a></div></footer>
		</div>
	</body>
</html>
