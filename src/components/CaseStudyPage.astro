---
import '../styles/global.css';
import WoodlandChrome from './WoodlandChrome.astro';
import WoodlandInit from './WoodlandInit.astro';
import ShareMeta from './ShareMeta.astro';

interface CaseStudySection {
	number: string;
	title: string;
	content: string;
}

interface Props {
	pageTitle: string;
	description: string;

	heading: string;
	subtitle: string;
	introduction: string;
	role: string;
	projectLinkLabel: 'See the site live' | 'Learn more';
	companyUrl?: string;
	shareImage: string;
	skillsIntroduction: string;
	technologies: string[];
	sections: CaseStudySection[];
}

const {
	pageTitle,
	description,

	heading,
	subtitle,
	introduction,
	role,
	projectLinkLabel,
	companyUrl,
	shareImage,
	skillsIntroduction,
	technologies,
	sections,
} = Astro.props;

const hasMedia = Astro.slots.has('media');
---

<!doctype html>
<html lang="en">
	<head>
		<WoodlandInit />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<ShareMeta title={pageTitle} description={description} image={shareImage} imageAlt={`${heading} project screenshot`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body class="woodland-page woodland-focus">
		<WoodlandChrome />
		<div class="scroll-cue" aria-hidden="true"><span>Read more</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
		<div class="page-shell">

			<main>
				<section class="case-hero py-20 sm:py-28">
					<a class="case-back" href="/#selected-work"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m14 5-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Back to projects</span></a>
					<h1 class="max-w-5xl text-balance text-[clamp(3.5rem,8vw,7.5rem)] font-semibold leading-[0.92] tracking-[-0.065em] animate-in delay-1">{heading}</h1>
					<p class="mt-5 text-2xl text-muted animate-in delay-1 sm:text-3xl">{subtitle}</p>
					<p class="mt-9 max-w-3xl text-pretty text-lg leading-8 text-muted animate-in delay-2 sm:text-xl">{introduction}</p>
					<div class="mt-10 flex flex-wrap items-end gap-x-16 gap-y-6 animate-in delay-3">
						<div><p class="text-sm text-muted">My Role</p><p class="mt-2 text-lg font-semibold">{role}</p></div>
						{companyUrl && <a class="nav-link inline-flex items-center gap-2 text-lg leading-7 font-semibold underline decoration-line underline-offset-4" href={companyUrl} target="_blank" rel="noopener noreferrer">{projectLinkLabel} <span aria-hidden="true">↗</span></a>}
					</div>
				</section>

				<section class="py-16 sm:py-24" aria-labelledby={hasMedia ? undefined : 'project-preview'}>
					{hasMedia ? <div class="overflow-hidden rounded-[2rem] border border-line bg-[#181a19] p-3 sm:p-5"><div class="overflow-hidden rounded-xl"><slot name="media" /></div></div> : <div class="relative min-h-[28rem] overflow-hidden rounded-[2rem] bg-[#181a19] p-6 sm:min-h-[40rem] sm:p-10">
						<div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(166,79,54,0.22),transparent_30%),radial-gradient(circle_at_82%_82%,rgba(243,241,235,0.12),transparent_38%)]"></div>
						<div class="relative flex min-h-[25rem] items-center justify-center rounded-2xl border border-white/15 bg-white/5 p-8 sm:min-h-[35rem]">
							<slot name="media">
								<div class="text-center text-paper"><h2 id="project-preview" class="text-3xl font-semibold tracking-[-0.04em]">Screenshots coming soon</h2>{companyUrl && <p class="mt-4 text-paper/80"><a class="underline underline-offset-4 hover:text-paper focus-visible:outline-paper" href={companyUrl} target="_blank" rel="noopener noreferrer">Visit the site</a> in the meantime.</p>}</div>
							</slot>
						</div>
					</div>}
				</section>

				<section class="border-t border-line py-16 sm:py-24">
					<div class="section-grid">
						<div><h2 class="section-heading">Full-stack product development.</h2></div>
						<div><p class="max-w-2xl text-lg leading-8 text-muted">{skillsIntroduction}</p><ul class="mt-8 flex flex-wrap gap-2" aria-label="Technologies used">{technologies.map((technology) => <li class="tag">{technology}</li>)}</ul></div>
					</div>
				</section>

				<section class="border-t border-line py-16 sm:py-24">
					<div class="section-grid">
						<div><h2 class="section-heading">The work behind the product.</h2></div>
						<div class="divide-y divide-line border-y border-line">
							{sections.map((section) => <section class="grid gap-4 py-8 sm:grid-cols-[4rem_1fr] sm:py-10"><span class="font-mono text-xs text-muted">{section.number}</span><div><h3 class="text-2xl font-semibold tracking-[-0.035em]">{section.title}</h3><p class="mt-3 max-w-2xl leading-7 text-muted">{section.content}</p></div></section>)}
						</div>
					</div>
				</section>
			</main>

			<footer class="flex flex-col gap-6 border-t border-line py-9 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Ben Hayden</p><div class="flex gap-6"><a class="nav-link" href="https://github.com/benLavavein" target="_blank" rel="noreferrer">GitHub</a><a class="nav-link" href="https://www.linkedin.com/in/henjiman/" target="_blank" rel="noreferrer">LinkedIn</a></div></footer>
		</div>
	</body>
</html>

<style>
  .scroll-cue { position: fixed; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 3px; color: #626b65; opacity: .6; font-size: 18px; letter-spacing: .04em; pointer-events: none; z-index: 5; }
  .case-hero { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: calc(100svh - 180px); }
  @media (max-width: 650px) { .case-hero { min-height: calc(100svh - 150px); } }
  .case-back { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-bottom: 24px; color: #526744; font-size: 15px; font-weight: 500; border-radius: 4px; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .25s ease, text-decoration-color .25s ease; }
  .case-back svg { flex-shrink: 0; transition: transform .25s ease; }
  .case-back:is(:hover, :focus-visible) { color: #243e30; }
  .case-back:is(:hover, :focus-visible) { text-decoration-color: currentColor; }
  .case-back:is(:hover, :focus-visible) svg { transform: translateX(-3px); }
  .case-back:focus-visible { outline: 2px solid #526744; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .case-back, .case-back svg { transition: none; } }
</style>

<script>
  let disposeScrollCue: (() => void) | undefined;
  function setupScrollCue() {
    disposeScrollCue?.();
    const cue = document.querySelector<HTMLElement>('.scroll-cue');
    if (!cue) return;
    const update = () => {
      cue.style.opacity = String(.6 * Math.max(0, 1 - window.scrollY / 180));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    disposeScrollCue = () => window.removeEventListener('scroll', update);
  }
  document.addEventListener('astro:page-load', setupScrollCue);
  document.addEventListener('astro:before-swap', () => disposeScrollCue?.());
</script>
