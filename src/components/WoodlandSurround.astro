---
const stems = [
  { x: 75, y: 1150, angle: 21, scale: 1.65, depth: .12, soft: true },
  { x: 0, y: 850, angle: 38, scale: 1.1, depth: .1, soft: true },
  { x: 1510, y: 1160, angle: -24, scale: 1.8, depth: .15, soft: true },
  { x: 1620, y: 820, angle: -32, scale: 1.15, depth: .13, soft: true },
  { x: -65, y: 690, angle: 38, scale: 1.05 },
  { x: -45, y: 860, angle: 58, scale: .85 },
  { x: 1655, y: 735, angle: -42, scale: 1.32 },
  { x: 1640, y: 920, angle: -62, scale: .9 },
];
const leaflets = Array.from({ length: 15 }, (_, i) => ({ y: -35 - i * 21, width: 66 * Math.sin((i + 2) / 18 * Math.PI) * (1 - i / 24) }));
const canopyLeaves = [
  'M0 0C-10-28 2-64 25-78C47-49 34-15 0 0Z',
  'M0 0C-3-24 13-58 25-78C37-49 24-15 0 0Z',
  'M0 0C-20-27-3-55 14-61Q24-66 25-78C54-45 34-8 0 0Z',
];
const sideLeaves = [
  'M0 0C4 25 27 48 56 45C57 17 28-1 0 0Z',
  'M0 0C12 19 31 38 56 45C48 19 27 5 0 0Z',
  'M0 0C-4 30 30 57 56 45Q49 35 46 26C32 10 16-4 0 0Z',
];
const variation = (seed: number) => Math.abs(Math.sin(seed * 127.1 + 311.7) * 43758.5453) % 1;
const sway = (seed: number) => `--sway-delay: ${-variation(seed) * 30}s; --sway-duration: ${9 + variation(seed + 17) * 9}s; --sway-from: ${-1 - variation(seed + 31) * 1.5}deg; --sway-to: ${1 + variation(seed + 47) * 2}deg; --sway-direction: ${variation(seed + 61) > .5 ? 'alternate' : 'alternate-reverse'}`;
const fernShape = (width: number, type: number) => [
  `M0 0Q${width * .4} -30 ${width} -42Q${width * .85} -20 ${width * .6} -12L${width * .62} -17Q${width * .3} -2 0 0Z`,
  `M0 0Q${width * .35} -23 ${width} -42Q${width * .72} -15 0 0Z`,
  `M0 0Q${width * .2} -25 ${width * .58} -30L${width * .55} -34Q${width * .8} -37 ${width} -42Q${width * .85} -20 ${width * .66} -19L${width * .69} -24Q${width * .4} -5 0 0Z`,
][type];
---

<div class="woodland-surround" data-woodland-zoom={Astro.url.pathname.startsWith('/work/') ? 'in' : 'out'} aria-hidden="true" transition:persist="woodland-scene" transition:animate="none">
  <div class="forest-haze"></div>
  <svg class="forest-frame" viewBox="0 0 1600 1100" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <linearGradient id="fern-ink" x1="0" y1="0" x2="90" y2="-300" gradientUnits="userSpaceOnUse"><stop stop-color="#203f30"/><stop offset=".5" stop-color="#57724a"/><stop offset="1" stop-color="#a0a479"/></linearGradient>
      <linearGradient id="canopy-ink" x1="0" y1="0" x2="500" y2="300" gradientUnits="userSpaceOnUse"><stop stop-color="#243e30"/><stop offset="1" stop-color="#76845b"/></linearGradient>
      <g id="canopy-sprig">
        <path d="M0 0Q120 60 270 90" stroke="#665c3f" stroke-width="4"/>
        {[0, 1, 2, 3, 4].map((i) => <g transform={`translate(${40 + i * 43} ${18 + i * 15}) rotate(${i * 5})`}>
          <path d={canopyLeaves[[0, 2, 1, 0, 2][i]]} fill="url(#canopy-ink)"/>
          <path d={sideLeaves[[1, 0, 2, 2, 0][i]]} fill="url(#canopy-ink)"/>
          <path d="M0 0Q18-28 25-70M0 0Q29 17 49 40" stroke="#c4c699" stroke-width=".8" opacity=".45"/>
        </g>)}
      </g>
    </defs>
    <g class="distant-canopy plant-enter" opacity=".13" data-depth="0.06" style="--enter-y: -160px; --enter-delay: 0s">
      <use href="#canopy-sprig" transform="translate(0 120) rotate(-15) scale(2.5)"/>
    </g>
    <g class="plant-enter" style="--enter-y: -260px; --enter-delay: .1s"><g class="canopy-left"><path d="M-50-50Q80 30 250 55" stroke="#4d4c32" stroke-width="12"/><use href="#canopy-sprig" transform="translate(-35 12) rotate(27) scale(1.3)"/><use href="#canopy-sprig" transform="translate(90 -35) rotate(12) scale(.95)"/></g></g>
    {stems.map(({ x, y, angle, scale, depth, soft }, index) => <g data-depth={depth ?? 0} class:list={['plant-enter', { 'soft-ferns': soft }]} style={`--enter-x: ${x < 800 ? -260 : 260}px; --enter-delay: ${.12 + index * .055}s`}><g transform={`translate(${x} ${y}) rotate(${angle}) scale(${scale})`}>
      <g class="fern" style={sway(index + 1)}>
        <path d="M0 30Q-12-160 0-370" stroke="#7c8153" stroke-width="2"/>
        {leaflets.map(({ y, width }, i) => <g transform={`translate(${-6 * Math.sin(i / 14 * Math.PI)} ${y})`}>
          {[-1, 1].map((side) => <g transform={`scale(${side} 1) rotate(${(variation(i * 13 + index * 37 + side) - .5) * 12}) scale(${.88 + variation(i * 7 + index * 31 + side) * .24} 1)`}>
            <path d={fernShape(width, Math.floor(variation(i * 17 + index * 41 + side) * 3))} fill="url(#fern-ink)"/>
            <path d={`M0 0Q${width * .5} -18 ${width * .95} -39`} stroke="#bcc18b" stroke-width=".6" opacity=".5"/>
          </g>)}
        </g>)}
      </g>
    </g></g>)}
    {[{ x: -10, y: 450, flip: 1, size: 1 }, { x: 1610, y: 565, flip: -1, size: 1.18 }].map(({ x, y, flip, size }) => <g data-depth="0" class="plant-enter" style={`--enter-x: ${flip * -180}px; --enter-delay: ${flip === 1 ? .25 : .4}s`}>
      <g transform={`translate(${x} ${y}) scale(${flip * size} ${size}) rotate(28)`}>
        <g class="fern" style={sway(x + 101)}>
          <path d="M0 120Q40 10 21-160" stroke="#63704b" stroke-width="2"/>
          {[{ x: 19, y: -125, angle: -55, scale: .7 }, { x: 25, y: -78, angle: 40, scale: .85 }, { x: 24, y: -22, angle: -65, scale: 1 }, { x: 13, y: 48, angle: 38, scale: .9 }].map(leaf => <g transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.angle}) scale(${leaf.scale})`}>
            <path d="M0 0C-23-14-45-44-30-68C-18-86-3-70 0-59C6-79 29-85 37-64C47-35 14-5 0 0Z" fill="#687b51"/>
            <path d="M0 0L0-59M0-15L-23-45M0-29L-25-59M0-15L26-42M0-30L28-59" stroke="#bac197" stroke-width="1" opacity=".55"/>
          </g>)}
        </g>
      </g>
    </g>)}
  </svg>
  <svg class="forest-frame forest-floor" viewBox="0 800 1600 300" fill="none">
    {[{ x: 75, y: 1120, flip: 1 }, { x: 185, y: 1170, flip: 1 }, { x: 1450, y: 1150, flip: -1 }, { x: 1570, y: 1120, flip: -1 }].map(({ x, y, flip }, index) => <g data-depth="0" class="plant-enter" style={`--enter-y: 300px; --enter-delay: ${.3 + index * .09}s`}>
      <g transform={`translate(${x} ${y}) scale(${flip} 1)`}>
        <g class="fern" style={sway(x + 211)}>
          {[-68, -44, -20, 13, 39, 65].map((bend, i) => <path d={`M0 0Q${bend * .25} -120 ${bend} ${-210 - i % 3 * 35}Q${bend * .5} -100 0 0Z`} fill={i % 2 ? '#8a9061' : '#536c43'}/>)}
          <path d="M0 0Q55-140 32-292M0 0Q-50-110-40-250" stroke="#8c8255" stroke-width="1.5"/>
          {[0, 1, 2, 3, 4, 5].map(i => <g transform={`translate(${33 + Math.sin(i * .5) * 4} ${-285 + i * 9})`}><ellipse rx="3" ry="8" transform="rotate(-32)" fill="#ac986a"/><ellipse cx="6" cy="5" rx="3" ry="7" transform="rotate(28 6 5)" fill="#93865b"/></g>)}
        </g>
      </g>
    </g>)}
    {[{ x: 135, y: 1085, flip: 1 }, { x: 1500, y: 1100, flip: -1 }].map(({ x, y, flip }) => <g data-depth="0" class="plant-enter" style={`--enter-y: 250px; --enter-delay: ${flip === 1 ? .5 : .65}s`}>
      <g transform={`translate(${x} ${y}) scale(${flip} .95)`}>
        <g class="fern" style={sway(x + 307)}>
          <path d="M0 60Q30-60 12-180M18-100Q-18-135-35-149M21-58Q48-96 65-109" stroke="#778064" stroke-width="2"/>
          <path d="M18-48Q-14-85-23-61Q-18-39 18-48M20-81Q51-110 52-88Q46-72 20-81" fill="#73845a"/>
          {[{ x: 12, y: -180 }, { x: -35, y: -149 }, { x: 65, y: -109 }].map(flower => <g transform={`translate(${flower.x} ${flower.y})`}>
            {[0, 72, 144, 216, 288].map(angle => <ellipse cy="-7" rx="4" ry="8" transform={`rotate(${angle})`} fill="#eee7cd" stroke="#c3bda2" stroke-width=".5"/>)}
            <circle r="3.5" fill="#ae8b47"/>
          </g>)}
        </g>
      </g>
    </g>)}
  </svg>
  <div class="sun-rays"></div>
  <div class="forest-grain"></div>
</div>

<script>
  let dispose: (() => void) | undefined;

  function setupWoodlandMotion() {
    dispose?.();
    const scene = document.querySelector<HTMLElement>('.woodland-surround');
    if (!scene) return;
    const layers = Array.from(scene.querySelectorAll<SVGGElement>('[data-depth]')).map(element => ({ element, depth: Number(element.dataset.depth) }));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const options = { signal: controller.signal, passive: true };
    let frame = 0;
    function render() {
      frame = 0;
      const range = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const scroll = Math.min(1, Math.max(0, scrollY / range)) * 180;
      for (const { element, depth } of layers) {
        element.style.transform = `translateY(${-scroll * depth}px)`;
      }
    }

    function schedule() {
      if (!frame && !reduced.matches && !document.hidden) frame = requestAnimationFrame(render);
    }

    function updateScroll() {
      schedule();
    }

    function updatePreferences() {
      if (reduced.matches) {
        cancelAnimationFrame(frame);
        frame = 0;
        layers.forEach(({ element }) => element.style.removeProperty('transform'));
      } else {
        updateScroll();
      }
    }

    window.addEventListener('scroll', updateScroll, options);
    window.addEventListener('resize', updateScroll, options);
    reduced.addEventListener('change', updatePreferences, options);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(frame);
        frame = 0;
      } else updateScroll();
    }, options);
    dispose = () => {
      cancelAnimationFrame(frame);
      controller.abort();
    };
    updatePreferences();
  }

  setupWoodlandMotion();
  document.addEventListener('astro:page-load', setupWoodlandMotion);
  document.addEventListener('astro:before-swap', () => dispose?.());
</script>

<style>
  .woodland-surround { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: #efeee4; }
  .forest-haze { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 45%, #f5f2e9 20%, transparent 75%), linear-gradient(110deg, #bdc6a8, #f5f0db 48%, #b5c0a0); }
  .forest-frame { position: absolute; height: 100%; width: 100%; filter: drop-shadow(5px 13px 9px #233c3020); }
  .forest-floor { bottom: 0; height: auto; aspect-ratio: 16 / 3; overflow: visible; transform-origin: center bottom; }
  .distant-canopy { filter: blur(9px); }
  .plant-enter { animation: plant-arrive 1.8s var(--enter-delay, 0s) cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes plant-arrive { from { translate: var(--enter-x, 0px) var(--enter-y, 0px); } to { translate: 0 0; } }
  .soft-ferns { opacity: .23; filter: blur(1.2px); }
  .canopy-left { transform-origin: 0 0; animation: canopy-breathe 18s ease-in-out infinite alternate; }
  .canopy-right { transform-origin: 100% 0; animation: canopy-breathe 22s -8s ease-in-out infinite alternate-reverse; }
  .fern { transform-origin: 0 0; animation: fern-breathe var(--sway-duration) var(--sway-delay) ease-in-out infinite var(--sway-direction); }
  .sun-rays { position: absolute; inset: -30%; background: repeating-conic-gradient(from 163deg at 75% 0%, transparent 0deg 9deg, #fff8ce18 10deg 13deg, transparent 15deg 24deg); filter: blur(15px); animation: sunlight 24s ease-in-out infinite alternate; }
  .forest-grain { position: absolute; inset: 0; opacity: .09; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23525f40' filter='url(%23n)' opacity='.5' d='M0 0h180v180H0z'/%3E%3C/svg%3E"); }
  @keyframes canopy-breathe { to { rotate: 2deg; translate: 0 -6px; } }
  @keyframes fern-breathe { from { rotate: var(--sway-from); } to { rotate: var(--sway-to); } }
  @keyframes sunlight { from { opacity: .4; transform: translateX(-2%); } to { opacity: 1; transform: translateX(2%); } }
  @media (max-width: 900px) { .forest-frame { width: 140%; left: -20%; opacity: .45; } }
  @media (prefers-reduced-motion: reduce) { .plant-enter, .canopy-left, .canopy-right, .fern, .sun-rays { animation: none; } }
</style>
