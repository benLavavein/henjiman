---
const links = [
  { label: 'Home', href: '/', position: 'home' },
  { label: 'About', href: '/about/', position: 'about' },
  { label: 'Contact', href: '/contact/', position: 'contact' },
];
---

<nav class="leaf-navigation" aria-label="Primary navigation">
  <svg class="nav-stem" viewBox="0 0 520 210" fill="none" aria-hidden="true">
    <path d="M550-22C440 12 365 24 290 34S166 70 110 52Q65 40 35 12Q-4-23-35-90" stroke="#665c3f" stroke-width="6" stroke-linecap="round"/>
    <path d="M120 55Q98 61 90 75M258 39Q248 43 245 53M413 13Q404 20 400 26" stroke="#718165" stroke-width="4" stroke-linecap="round"/>
    <path d="M521-11Q375 27 291 36M111 53Q65 41 36 13" stroke="#a8a77d" stroke-width=".8"/>
  </svg>
  <ul>
    {links.map(({ label, href, position }) => <li class={position}>
      <a href={href} aria-current={href === Astro.url.pathname ? 'page' : undefined}>
        <svg viewBox="0 0 160 100" aria-hidden="true">
          <defs><linearGradient id={`nav-leaf-${position}`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#57724a"/><stop offset="1" stop-color="#243e30"/></linearGradient></defs>
          <path class="leaf-blade" d="M80 8C28 11 7 47 16 90C82 99 144 53 80 8Z" fill={`url(#nav-leaf-${position})`}/>
          <path d="M80 8Q62 51 19 87M70 28L43 25M60 45L27 43M44 65L20 62M69 30L98 37M59 47L93 57M44 65L68 76" fill="none" stroke="#b0b78b" stroke-width=".9" opacity=".4"/>
        </svg>
        <span>{label}</span>
      </a>
    </li>)}
  </ul>
</nav>

<script>
  const navigation = document.querySelector<HTMLElement>('.leaf-navigation');
  const hero = document.querySelector<HTMLElement>('.woodland-hero');
  if (navigation && hero) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const bottom = hero.getBoundingClientRect().bottom;
      navigation.style.top = `${Math.min(0, bottom - navigation.getBoundingClientRect().height)}px`;
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>

<style>
  .leaf-navigation { position: fixed; right: 0; top: 0; z-index: 20; width: 624px; height: 252px; pointer-events: none; }
  .nav-stem { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { position: absolute; width: 216px; height: 135px; }
  .home { left: 0; top: 78px; }
  .about { left: 186px; top: 51.6px; }
  .contact { left: 372px; top: 19.2px; }
  a { position: relative; display: block; width: 100%; height: 100%; color: #faf6e9; font-size: 21px; font-weight: 600; border-radius: 55% 40% 55% 20%; transition: transform .5s ease; transform-origin: 50% 8%; pointer-events: auto; }
  a svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(3px 7px 4px #26382420); }
  a span { position: absolute; left: 40%; top: 53%; transform: translate(-50%, -50%); }
  a:hover { transform: rotate(-4deg); }
  a:focus-visible { outline: 2px solid #334b30; outline-offset: 3px; }
  a[aria-current="page"] span { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 650px) { .leaf-navigation { transform: scale(.65); transform-origin: top right; } }
  @media (max-width: 420px) { .leaf-navigation { transform: scale(.56); } }
  @media (max-width: 360px) { .leaf-navigation { transform: scale(.5); } }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } a:hover { transform: none; } }
</style>
