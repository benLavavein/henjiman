---
interface Props {
	title: string;
	subtitle: string;
	role: string;
	description: string;
	href: string;
	imageSrc?: string;
	imageAlt?: string;
	mediaPosition?: 'left' | 'right';
}

const { title, subtitle, role, description, href, imageSrc, imageAlt = '', mediaPosition = 'left' } = Astro.props;
const mediaOrder = mediaPosition === 'right' ? 'lg:order-2' : '';
const contentOrder = mediaPosition === 'right' ? 'lg:order-1' : '';
const gridColumns = mediaPosition === 'right' ? 'lg:grid-cols-[0.85fr_1.15fr]' : 'lg:grid-cols-[1.15fr_0.85fr]';
const mediaBorder = mediaPosition === 'right' ? 'border-b border-line lg:border-b-0 lg:border-l' : 'border-b border-line lg:border-r lg:border-b-0';
---

<article class="group overflow-hidden rounded-3xl border border-line bg-card">
	<a class:list={['grid', gridColumns]} href={href} aria-label={`View ${title} project`}>
		<div class:list={['relative aspect-[16/9] overflow-hidden lg:aspect-auto lg:min-h-80', mediaOrder, imageSrc ? `${mediaBorder} bg-[#d1d6c4]` : 'bg-[#181a19] p-6 sm:p-10']}>
			{imageSrc ? <div class="absolute inset-3 overflow-hidden rounded-xl sm:inset-5"><img class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015]" src={imageSrc} alt={imageAlt} loading="lazy" /></div> : <>
				<div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(166,79,54,0.2),transparent_34%),radial-gradient(circle_at_80%_80%,rgba(243,241,235,0.12),transparent_38%)]"></div>
				<div class="relative flex h-full min-h-68 items-center justify-center overflow-hidden rounded-2xl border border-white/15 bg-white/5 transition-transform duration-500 group-hover:scale-[1.015] sm:min-h-[25rem]">
					<div class="w-full max-w-lg overflow-hidden rounded-xl border border-white/15 bg-[#202a23] shadow-2xl">
					<div class="flex items-center gap-2 border-b border-white/10 px-4 py-3"><span class="size-2 rounded-full bg-accent"></span><span class="size-2 rounded-full bg-white/25"></span><span class="size-2 rounded-full bg-white/25"></span></div>
					<div class="grid min-h-56 grid-cols-[4rem_1fr] sm:min-h-72 sm:grid-cols-[6rem_1fr]">
						<div class="border-r border-white/10 p-3"><div class="h-5 w-5 rounded bg-accent/80"></div><div class="mt-8 space-y-3"><div class="h-1.5 rounded bg-white/20"></div><div class="h-1.5 rounded bg-white/10"></div><div class="h-1.5 rounded bg-white/10"></div></div></div>
						<div class="p-5 sm:p-7"><div class="h-3 w-2/5 rounded bg-white/70"></div><div class="mt-6 grid grid-cols-2 gap-3"><div class="h-20 rounded-lg bg-white/8"></div><div class="h-20 rounded-lg bg-accent/10"></div></div><div class="mt-3 h-20 rounded-lg bg-white/8"></div></div>
					</div>
					</div>
				</div>
			</>}
		</div>
		<div class:list={['flex flex-col justify-between p-6 sm:p-8', contentOrder]}>
			<div>
				<h3 class="text-3xl font-semibold tracking-[-0.05em] sm:text-4xl">{title}</h3>
				<p class="mt-2 text-lg text-muted">{subtitle}</p>
				<p class="mt-4 max-w-lg text-base leading-7 text-muted">{description}</p>
			</div>
			<span class="mt-6 inline-flex items-center gap-3 text-sm font-semibold">View project <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></span>
		</div>
	</a>
</article>
