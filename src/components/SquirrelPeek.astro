<div class="squirrel-peek" aria-hidden="true" transition:persist="woodland-squirrel" transition:animate="none"><img src="/images/grey-squirrel.png" alt="" /></div>

<script>
  function setupSquirrel() {
  const squirrel = document.querySelector<HTMLElement>('.squirrel-peek');
  const oak = document.querySelector<HTMLElement>('.oak-branch');
  if (squirrel && oak) {
    const controller = new AbortController();
    let frame = 0;
    const update = () => {
      frame = 0;
      squirrel.classList.toggle('visible', oak.getBoundingClientRect().bottom < -24);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true, signal: controller.signal });
    window.addEventListener('resize', schedule, { passive: true, signal: controller.signal });
    window.addEventListener('load', schedule, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => { controller.abort(); cancelAnimationFrame(frame); }, { once: true });
    update();
  }
  }
  document.addEventListener('astro:page-load', setupSquirrel);
</script>

<style>
  .squirrel-peek { position: fixed; right: -4px; top: 8%; width: clamp(100px, 11vw, 175px); z-index: 4; pointer-events: none; transform: translateX(110%) rotate(8deg); transform-origin: right bottom; transition: transform 1.2s cubic-bezier(.22, 1, .36, 1); }
  .squirrel-peek.visible { transform: translateX(0) rotate(0); }
  img { display: block; width: 100%; height: auto; }
  @media (max-width: 650px) { .squirrel-peek { width: 85px; top: 6%; } }
  @media (prefers-reduced-motion: reduce) { .squirrel-peek { transition: none; } }
</style>
